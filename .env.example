# ---- Required ----
DISCORD_TOKEN=your-bot-token-here

# ---- Storage ----
# Local default is data/bot.db. On Railway, attach a Volume mounted at /data and set:
# DB_PATH=/data/bot.db
DB_PATH=data/bot.db

# ---- Time / schedules (all hours are 0-23 in TIMEZONE) ----
TIMEZONE=Asia/Kolkata
CHECKIN_HOUR=21
NEWS_HOUR=8
CHALLENGE_HOUR=9
DAILY_HOUR=9
# Weekly recap: weekday 0=Monday ... 6=Sunday
RECAP_WEEKDAY=6
RECAP_HOUR=20

# ---- Development ----
# Set to your test server's ID for instant slash-command updates (leave empty in production)
DEV_GUILD_ID=
# Set to 0 to skip syncing slash commands on startup
SYNC_COMMANDS=1

# ---- Optional: /explain (AI error helper) ----
# Works with any OpenAI-compatible chat API. Leave empty to disable the command.
# Examples of base URLs:
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# ---- Optional: /trending and /github (raises GitHub API rate limit) ----
GITHUB_TOKEN=

# ---- Optional: /run (code runner) ----
# Any Piston-compatible API. Leave PISTON_URL empty to turn /run off.
# If the default public server starts requiring a key, or you host your own Piston, change these.
PISTON_URL=https://emkc.org/api/v2/piston
PISTON_API_KEY=
